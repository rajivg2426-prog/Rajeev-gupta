{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalkart.example/schemas/document-instance.schema.json",
  "title": "LegalKart Document Instance (render context)",
  "description": "The fully-resolved data a template is rendered with: form answers, parties with OTP verification status, pincode-derived jurisdiction, frozen duty quote and the issued e-stamp certificate. Persisted as a snapshot next to every generated output so a document can be re-rendered byte-for-byte.",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentId", "referenceNo", "template", "status", "form", "parties", "pincodeData", "dutyQuote", "verification", "eStamp", "generatedAt"],
  "properties": {
    "documentId": { "type": "string", "format": "uuid" },
    "referenceNo": { "type": "string", "pattern": "^LK-\\d{4}-\\d{6}$" },
    "template": {
      "type": "object", "additionalProperties": false, "required": ["templateKey", "version"],
      "properties": { "templateKey": { "type": "string" }, "version": { "type": "string" } }
    },
    "status": { "enum": ["DRAFT", "AWAITING_VERIFICATION", "READY_FOR_PAYMENT", "PAYMENT_PENDING", "PAID", "ESTAMP_PROCESSING", "ESTAMP_ISSUED", "GENERATED", "CANCELLED", "FAILED"] },
    "form": { "type": "object", "description": "Answers keyed by section id → field id. Money fields are integers in paise." },

    "parties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partyId", "role", "sequence", "fullName", "phoneMasked", "verification"],
        "properties": {
          "partyId": { "type": "string", "format": "uuid" },
          "role": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 1 },
          "fullName": { "type": "string" },
          "relation": { "type": "string" },
          "relationName": { "type": "string" },
          "age": { "type": "integer", "minimum": 18, "maximum": 120 },
          "address": { "type": "string" },
          "phoneMasked": { "type": "string", "pattern": "^\\+91\\*{6}\\d{4}$" },
          "panMasked": { "type": "string", "pattern": "^[A-Z]{5}\\*{4}[A-Z]$|^\\*{6}\\d{3}[A-Z]$" },
          "verification": { "$ref": "#/$defs/partyVerification" }
        }
      }
    },

    "pincodeData": { "$ref": "#/$defs/pincodeData" },
    "dutyQuote": { "$ref": "#/$defs/dutyQuote" },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allRequiredVerified", "requiredRoles", "pendingPartyIds"],
      "properties": {
        "allRequiredVerified": { "type": "boolean" },
        "requiredRoles": { "type": "array", "items": { "type": "string" } },
        "pendingPartyIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    },

    "eStamp": { "$ref": "#/$defs/eStamp" },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },

  "$defs": {
    "partyVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["NOT_REQUIRED", "PENDING", "SENT", "VERIFIED", "FAILED", "EXPIRED", "LOCKED"] },
        "channel": { "enum": ["SMS", "WHATSAPP", "VOICE"] },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verificationId": { "type": "string", "format": "uuid" },
        "consentTextVersion": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "VERIFIED" } } },
      "then": { "required": ["channel", "verifiedAt", "verificationId"] }
    },

    "pincodeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pincode", "stateCode", "stateName", "district", "areaType", "sro", "resolution"],
      "properties": {
        "pincode": { "type": "string", "pattern": "^[1-9][0-9]{5}$" },
        "postOffice": { "type": "string" },
        "locality": { "type": "string" },
        "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "stateName": { "type": "string" },
        "district": { "type": "string" },
        "districtLgdCode": { "type": ["integer", "null"] },
        "areaType": { "enum": ["ANY", "URBAN", "RURAL", "METRO", "MUNICIPAL_CORPORATION", "MUNICIPAL_COUNCIL", "PANCHAYAT"] },
        "sro": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code", "name"],
          "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "address": { "type": "string" } }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confidence", "userConfirmed", "candidates"],
          "properties": {
            "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
            "userConfirmed": { "type": "boolean" },
            "candidates": { "type": "integer", "minimum": 0, "description": "How many SRO/district candidates existed." }
          }
        }
      }
    },

    "dutyQuote": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["stateCode", "lines", "totalGovtPaise", "quoteHash", "quotedAt"],
      "properties": {
        "stateCode": { "type": "string" },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chargeType", "amountPaise", "basis", "rateId", "explanation"],
            "properties": {
              "chargeType": { "enum": ["STAMP_DUTY", "REGISTRATION_FEE", "SURCHARGE", "CESS", "MUTATION_FEE", "PROCESSING_FEE"] },
              "amountPaise": { "type": "integer", "minimum": 0 },
              "basis": { "type": "string" },
              "baseAmountPaise": { "type": "integer", "minimum": 0 },
              "rateBps": { "type": ["integer", "null"] },
              "rateId": { "type": "integer" },
              "articleRef": { "type": ["string", "null"] },
              "explanation": { "type": "string" },
              "payableAt": { "enum": ["ESTAMP", "SRO"] }
            }
          }
        },
        "totalGovtPaise": { "type": "integer", "minimum": 0 },
        "estampAmountPaise": { "type": "integer", "minimum": 0 },
        "quoteHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "quotedAt": { "type": "string", "format": "date-time" },
        "verifiedRates": { "type": "boolean", "description": "False if any line used an unverified rate (blocked in production)." }
      }
    },

    "eStamp": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["transactionId", "status", "provider", "stampDutyPaise"],
      "properties": {
        "transactionId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["INITIATED", "SUBMITTED", "ISSUED", "FULFILMENT_PENDING", "DELIVERED", "FAILED", "MANUAL_REVIEW", "REFUND_REQUESTED", "REFUNDED"] },
        "provider": { "type": "string" },
        "fulfilmentMode": { "enum": ["DIGITAL_SELF_PRINT", "ACC_PRINT_COURIER", "ACC_PICKUP", "FRANKING"] },
        "certificateNo": { "type": "string", "description": "Unique certificate number / URN, e.g. IN-DL12345678901234X" },
        "uniqueDocReference": { "type": "string" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "accCode": { "type": "string" },
        "articleCode": { "type": "string" },
        "descriptionOfDocument": { "type": "string" },
        "propertyDescription": { "type": "string" },
        "considerationPaise": { "type": "integer", "minimum": 0 },
        "stampDutyPaise": { "type": "integer", "minimum": 0 },
        "firstParty": { "type": "string" },
        "secondParty": { "type": "string" },
        "dutyPaidBy": { "type": "string" },
        "purchasedBy": { "type": "string" },
        "verificationUrl": { "type": "string", "format": "uri" }
      },
      "if": { "properties": { "status": { "enum": ["ISSUED", "FULFILMENT_PENDING", "DELIVERED"] } } },
      "then": { "required": ["certificateNo", "issuedAt"] }
    }
  }
}
