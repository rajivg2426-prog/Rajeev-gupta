{
  "name": "legalkart",
  "private": true,
  "description": "LegalKart: ready-to-sign Indian property documents. Monorepo for the mobile app, API and shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @legalkart/api",
    "test": "npm test -w @legalkart/api",
    "typecheck": "npm run typecheck -w @legalkart/api",
    "demo": "npm run demo -w @legalkart/api"
  }
}
